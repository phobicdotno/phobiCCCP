<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-carbide-create">
    <comment>Carbide Create design</comment>
    <glob pattern="*.c2d"/>
    <icon name="phobicccp"/>
  </mime-type>
  <mime-type type="application/x-syntexophobic-project">
    <comment>Syntexophobic project</comment>
    <sub-class-of type="application/zip"/>
    <magic priority="70">
      <match type="string" offset="30" value="mimetypeapplication/x-syntexophobic-project"/>
    </magic>
    <glob pattern="*.cccp"/>
  </mime-type>
</mime-info>
